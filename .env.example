# Hedera / deployment
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
PRIVATE_KEY=your_private_key_here
ACCOUNT_ID=0.0.1234567
EVM_ADDRESS=0x_your_evm_public_address

# Mirror node (contract event log source for the frontend)
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1

# On-chain contracts (filled after deploy-ledger.ts)
LEDGER_ADDRESS=0x_your_ledger_address
REGISTRY_ANCHOR_ADDRESS=0x_your_anchor_address

# Configured platform (configurePlatform on the ledger)
PLATFORM_ID=0x00000000000000000000000000000000000000000000000000000073756b756b
PLATFORM_TOKEN=0x_your_ats_token_diamond
PLATFORM_USD_FEED=0x_your_chainlink_feed