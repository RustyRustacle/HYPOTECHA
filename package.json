{
  "name": "hypotheca",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "build:contracts": "npm --workspace @hypotheca/contracts run build",
    "test:contracts": "npm --workspace @hypotheca/contracts run test",
    "deploy:testnet": "npm --workspace @hypotheca/contracts run deploy:testnet",
    "audit": "npm run test:contracts && npm --workspace @hypotheca/contracts run typecheck && npm --workspace apps/web run lint && npm run build:web"
  }
}
